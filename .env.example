DATABASE_URL=postgresql://selfcloud:selfcloud@localhost:5432/selfcloud?schema=public
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_API_URL=/api
FRONTEND_ORIGIN=*
PORT=4000
MAX_FILE_SIZE_BYTES=5368709120
SESSION_TTL_DAYS=30
NODE_ENV=development
STORAGE_PATH=/srv/secure-cloud-storage
STORAGE_LIMIT_BYTES=5368709120

# WhatsApp Cloud API notification for the native Quick Tunnel scripts.
# Keep these values only in the local .env; never commit real credentials.
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_RECIPIENT=replace-with-recipient-phone-number
WHATSAPP_API_VERSION=v23.0
# Optional approved template: two positional body parameters (URL, health status).
# WHATSAPP_TEMPLATE_NAME=secure_cloud_tunnel
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Monitoring (see monitoring/README.md); credentials are generated, not committed.
# Use your public HTTPS hostname here when it is stable.
GRAFANA_ROOT_URL=http://localhost:8080/grafana/
# Backend metrics always bind to 127.0.0.1; no public API endpoint.
METRICS_PORT=4001
# Set true when Grafana is accessed exclusively over HTTPS.
GRAFANA_COOKIE_SECURE=false
# Optional persistent secrets directory for a deployment outside this checkout:
# MONITORING_RUNTIME_DIR=/etc/secure-cloud/monitoring

# Match RUNTIME_DIR only if your native Cloudflare scripts use a custom directory.
# CLOUDFLARED_RUNTIME_DIR=/absolute/path/to/.runtime
