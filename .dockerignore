# Keep build contexts small and prevent local state or secrets entering images.
.git
.github
.codex
.agents
**/node_modules
**/.next
**/.next-dev
**/dist
**/coverage
**/.env
**/.env.*
!**/.env.example
monitoring/runtime
.runtime
infra/.terraform
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/terraform.tfvars
/srv
*.log
*.pid
*.tmp
.DS_Store
README.md
CURRENT_ARCHITECTURE_AND_FLOW.md
PROJECT_OVERVIEW.md
