aws_region = "us-east-1"
project_name = "secure-cloud"
environment = "production"
instance_type = "t3.micro"
ssh_key_name = ""
ssh_allowed_cidrs = []
assign_public_ip = true
create_private_subnet = true
enable_cloudwatch = false
tailscale_auth_key = ""
tailscale_hostname = "secure-cloud-ec2"

# Never put Cloudflare tokens, database credentials, Redis credentials or
# application secrets here. Terraform state can contain sensitive values.
