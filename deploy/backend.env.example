# Stored on the Ubuntu server as /etc/secure-cloud/backend.env (mode 0600).
# Containers use Linux host networking, so the existing native services stay reachable.
DATABASE_URL=postgresql://selfcloud:CHANGE_ME@127.0.0.1:5432/selfcloud?schema=public
REDIS_URL=redis://127.0.0.1:6379
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_ORIGIN=https://cloud.example.com
NODE_ENV=production
PORT=4000
STORAGE_PATH=/srv/secure-cloud-storage
STORAGE_LIMIT_BYTES=5368709120
MAX_FILE_SIZE_BYTES=5368709120
SESSION_TTL_DAYS=30
CACHE_TTL_SECONDS=60
