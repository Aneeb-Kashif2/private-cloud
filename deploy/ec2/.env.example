# EC2 only. Do not put database, Redis, storage or backend secrets here.
FRONTEND_IMAGE=secure-cloud-frontend:local
UBUNTU_TAILSCALE_HOST=ubuntu-secure-cloud.tailnet-name.ts.net
# Root-readable token file, mode 0600; never commit it.
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/secure-cloud/ec2/cloudflare-tunnel-token
