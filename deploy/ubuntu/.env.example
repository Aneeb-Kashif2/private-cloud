POSTGRES_ENV_FILE=./postgres.env
BACKEND_IMAGE=secure-cloud-backend:local
APP_UID=1000
APP_GID=1000
POSTGRES_VOLUME_NAME=self-cloud-prj_postgres_data
REDIS_VOLUME_NAME=self-cloud-prj_redis_data
