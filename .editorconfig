# Editor defaults for every contributor, so diffs stay free of whitespace noise.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Makefiles and shell heredocs require real tab indentation.
[Makefile]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,mjs,json,css}]
indent_size = 2

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break, so do not strip them.
[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{conf,tf,tftpl}]
indent_size = 2
